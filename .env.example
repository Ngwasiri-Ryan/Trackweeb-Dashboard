# ── Brand (change per client — baked into UI at build time via VITE_*) ──
VITE_APP_NAME=Trackweeb
VITE_APP_LEGAL_NAME=Trackweeb Logistics B.V.
VITE_APP_TAGLINE=Shipment tracking admin dashboard
VITE_SITE_URL=https://trackweeb.com
VITE_SUPPORT_EMAIL=support@trackweeb.com
VITE_APP_LOGO_LETTER=T
VITE_ADMIN_TITLE=Trackweeb Admin

# ── Supabase ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# ── Email (Resend) — server + edge function secrets ──
APP_NAME=Trackweeb
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Trackweeb <onboarding@resend.dev>"
SUPPORT_EMAIL=support@trackweeb.com

# Server-side only — required for first-time auto-setup (dev server + edge function secrets)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_REGION=eu-west-1
SUPABASE_DB_POOLER=aws-1

# Login credentials are hardcoded in src/lib/admin-credentials.ts
# Optional overrides for first-time Supabase setup only:
# ADMIN_AUTH_EMAIL=trackweeb@auth.trackweeb.cm
ADMIN_FULL_NAME=Admin
TENANT_NAME=Logistics Inc
TENANT_SUBDOMAIN=logistics-inc
